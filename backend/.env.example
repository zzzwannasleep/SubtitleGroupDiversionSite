# Copy this file to backend/.env for local development.

DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=true
# Comma-separated hostnames only. Do not include http://, https://, paths, or ports.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SITE_BASE_URL=http://localhost:8000

# Optional MySQL configuration.
# MYSQL_DATABASE=subtitle_group
# MYSQL_USER=subtitle
# MYSQL_PASSWORD=change-me
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# Optional Redis cache/session backend.
# REDIS_URL=redis://localhost:6379/0

# Optional runtime settings.
# LOG_LEVEL=INFO
# MEDIA_ROOT=D:/subtitle-group-media

# Optional Torrust tracker integration.
# TRACKER_ENABLED=true
# TRACKER_ANNOUNCE_URL=http://127.0.0.1:7070/announce
# TRACKER_SCRAPE_URL=http://127.0.0.1:7070/scrape
# TRACKER_PUBLIC_SCRAPE_URL=http://127.0.0.1:7070/scrape
# TRACKER_AUTH_URL_STYLE=suffix
# TRACKER_AUTH_MODE=per_user
# TRACKER_REQUIRE_AUTH_DOWNLOADS=true
# TRACKER_FORCE_PRIVATE_TORRENTS=true
# TRACKER_SYNC_STRICT=false
# TORRUST_API_URL=http://127.0.0.1:1212
# TORRUST_API_TOKEN=change-me
# TORRUST_API_STATS_PATH=/api/v1/stats
# TORRUST_SHARED_AUTH_KEY=
# TORRUST_KEY_TTL_SECONDS=315360000
# TORRUST_KEY_RENEWAL_WINDOW_SECONDS=86400
