# Required application settings.
DJANGO_SECRET_KEY=change-me-before-production
# Comma-separated hostnames only. Do not include http://, https://, paths, or ports.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
SITE_BASE_URL=https://example.com
MYSQL_DATABASE=subtitle_group
MYSQL_USER=subtitle
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Optional runtime settings.
LOG_LEVEL=INFO
HTTP_PORT=80
# MEDIA_VOLUME_SPEC=D:/subtitle-group-media:/app/media
# 如果要用“服务器目录”模式或 qB HTTP 直链，建议单独映射资源目录。
# 尽量让 WEBSEED_LIBRARY_ROOT 与 /app/media 分开，避免站点内部目录写进资源盘。
WEBSEED_LIBRARY_ROOT=/app/webseed-library
WEBSEED_LIBRARY_URL_PATH=/webseed/
# WEBSEED_LIBRARY_PUBLIC_URL=https://example.com/webseed
# WEBSEED_LIBRARY_VOLUME_SPEC=D:/subtitle-group-library:/app/webseed-library

# Optional Torrust tracker integration.
# TRACKER_ENABLED=true
# COMPOSE_PROFILES=tracker
# TRACKER_IMAGE=torrust/tracker:develop
# TRACKER_ANNOUNCE_URL=http://example.com:7070/announce
# To auto-sync per-user upload/download/seeding stats via Django,
# point the public announce URL to the site proxy and keep Torrust internal.
# TRACKER_ANNOUNCE_URL=https://example.com/tracker/announce
# TRACKER_INTERNAL_ANNOUNCE_URL=http://tracker:7070/announce
# TRACKER_SCRAPE_URL=http://tracker:7070/scrape
# TRACKER_PUBLIC_SCRAPE_URL=https://example.com/tracker/scrape
# TRACKER_AUTH_MODE=per_user
# TRACKER_REQUIRE_AUTH_DOWNLOADS=true
# TRACKER_FORCE_PRIVATE_TORRENTS=true
# TRACKER_SYNC_STRICT=false
# TRACKER_AUTO_SYNC_ON_START=true
# TRACKER_AUTO_SYNC_TIMEOUT_SECONDS=90
# TRACKER_AUTO_SYNC_RETRY_INTERVAL_SECONDS=5
# TRACKER_AUTO_SYNC_INCLUDE_SCRAPE=false
# TORRUST_API_URL=http://tracker:1212
# TORRUST_API_TOKEN=change-me
# TORRUST_SHARED_AUTH_KEY=
# TORRUST_KEY_TTL_SECONDS=315360000
# TORRUST_KEY_RENEWAL_WINDOW_SECONDS=86400
# TRACKER_PEER_SNAPSHOT_STALE_SECONDS=900
# TRACKER_HTTP_PORT=7070
# TRACKER_UDP_PORT=6969
# TRACKER_API_PORT=1212

# Optional image settings. Change these when deploying locally built images.
BACKEND_IMAGE=zzzwannasleep111/subtitlegroupdiversionsite:latest
IMAGE_PULL_POLICY=always
